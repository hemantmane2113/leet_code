   "source": [
    "def lengthOfLastWord(s: str) -> int:\n",
    "    \n",
    "    # Split the string into words using space as the delimiter\n",
    "    words = s.split()\n",
    "    \n",
    "    # If there are no words, return 0\n",
    "    if not words:\n",
    "        return 0\n",
    "    \n",
    "    # Return the length of the last word\n",
    "    return len(words[-1])"
   ]
  }
 ],
