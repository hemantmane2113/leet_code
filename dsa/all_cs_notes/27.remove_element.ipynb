   "source": [
    "def removeElement(self, nums: list[int], val: int) -> int:\n",
    "        if not nums:\n",
    "            return 0\n",
    "\n",
    "        index = 0\n",
    "\n",
    "        for i in range(0,len(nums)):\n",
    "            if nums[i] != val:\n",
    "                nums[index] = nums[i]\n",
    "                index += 1\n",
    "\n",
    "        return index"
   ]
  }
