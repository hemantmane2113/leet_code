   "source": [
    "def removeStars(s: str) -> str:\n",
    "    n = len(s)\n",
    "    stack = []\n",
    "\n",
    "    for i in s:\n",
    "        if i == \"*\":\n",
    "            stack.pop()\n",
    "        else:\n",
    "            stack.append(i)\n",
    "    \n",
    "    return \"\".join(stack)\n"
   ]
  },
